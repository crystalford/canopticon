{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GapSurfacerOutput",
  "type": "object",
  "required": ["gaps", "summary"],
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "description", "target_question", "severity"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "entities",
              "time",
              "geography",
              "evidence",
              "source",
              "counter_cases",
              "lineage"
            ]
          },
          "description": { "type": "string" },
          "target_question": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["minor", "notable", "blocking"]
          },
          "suggested_role": {
            "type": "string",
            "enum": ["interrogator", "verifier", "operator_research"]
          }
        }
      }
    },
    "summary": { "type": "string" },
    "top_priorities": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
