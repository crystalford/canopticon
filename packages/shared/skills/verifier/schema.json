{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifierOutput",
  "type": "object",
  "required": ["claim_id", "verification_status", "reasoning", "citations"],
  "properties": {
    "claim_id": { "type": "string", "format": "uuid" },
    "verification_status": {
      "type": "string",
      "enum": ["grounded", "partial", "unsupported", "contradicted"]
    },
    "reasoning": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "cited_text"],
        "properties": {
          "source_id": { "type": "string", "format": "uuid" },
          "cited_text": { "type": "string" },
          "start_offset": { "type": ["integer", "null"], "minimum": 0 },
          "end_offset": { "type": ["integer", "null"], "minimum": 0 },
          "supports": { "type": "string", "enum": ["all", "partial", "contradicts"] }
        }
      }
    },
    "unsupported_components": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific assertions in claim_text that the source does NOT support. Required when verification_status='partial'."
    },
    "contradiction_note": {
      "type": ["string", "null"],
      "description": "Required when verification_status='contradicted'."
    }
  }
}
