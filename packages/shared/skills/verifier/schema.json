{
  "type": "object",
  "required": ["verification_status", "reasoning"],
  "properties": {
    "verification_status": {
      "type": "string",
      "enum": ["grounded", "partial", "unsupported", "contradicted"]
    },
    "suggested_ipcc_likelihood": {
      "type": ["string", "null"],
      "enum": [
        "virtually_certain",
        "extremely_likely",
        "very_likely",
        "likely",
        "more_likely_than_not",
        "about_as_likely_as_not",
        "unlikely",
        "very_unlikely",
        "extremely_unlikely",
        "exceptionally_unlikely",
        null
      ]
    },
    "supporting_source_ids": { "type": "array", "items": { "type": "string" } },
    "contradicting_source_ids": { "type": "array", "items": { "type": "string" } },
    "contradiction_pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_a": { "type": "string" },
          "source_b": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "reasoning": { "type": "string" }
  }
}
