{
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["data", "claim_text", "qualifier", "layer"],
        "properties": {
          "data": { "type": "string" },
          "claim_text": { "type": "string" },
          "warrant": { "type": ["string", "null"] },
          "backing": { "type": ["string", "null"] },
          "qualifier": { "type": "string" },
          "rebuttal": { "type": ["string", "null"] },
          "layer": {
            "type": "string",
            "enum": ["factual", "framing", "architectural", "distributive"]
          },
          "entities_mentioned": { "type": "array", "items": { "type": "string" } },
          "source_excerpt": { "type": "string" }
        }
      }
    }
  }
}
