{
  "type": "object",
  "required": ["audits"],
  "properties": {
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "new_status", "audit_notes"],
        "properties": {
          "assumption_id": { "type": "string" },
          "new_status": {
            "type": "string",
            "enum": ["holding", "weakening", "broken", "confirmed"]
          },
          "audit_notes": { "type": "string" },
          "linchpin_warning": { "type": "boolean" },
          "suggested_new_supporting_claims": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
