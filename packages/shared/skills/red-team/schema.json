{
  "type": "object",
  "required": ["vantage", "objections"],
  "properties": {
    "vantage": { "type": "string" },
    "objections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["objection_text", "severity", "proposed_response"],
        "properties": {
          "objection_text": { "type": "string" },
          "severity": { "type": "string", "enum": ["minor", "moderate", "severe", "fatal"] },
          "proposed_response": { "type": "string" }
        }
      }
    }
  }
}
