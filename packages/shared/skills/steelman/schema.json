{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SteelmanOutput",
  "type": "object",
  "required": ["opposing_position", "load_bearing_assumptions"],
  "properties": {
    "opposing_position": { "type": "string" },
    "load_bearing_assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "is_linchpin": { "type": "boolean" },
          "consequence_if_failed": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
