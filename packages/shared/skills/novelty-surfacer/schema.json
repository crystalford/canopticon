{
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["pattern", "novelty_grade", "supporting_claim_ids"],
        "properties": {
          "pattern": { "type": "string" },
          "proposed_coined_phrase": { "type": ["string", "null"] },
          "novelty_grade": { "type": "string", "enum": ["breakthrough", "notable", "incremental"] },
          "pattern_type": { "type": "string" },
          "supporting_claim_ids": { "type": "array", "items": { "type": "string" } },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
