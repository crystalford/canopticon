n\n<style>\n  .home-masthead { margin-bottom: 40px; }\n  .home-masthead .kicker { margin-bottom: 18px; }\n  .home-hero {\n    font-family: var(--serif);\n    font-size: 48px; line-height: 1.08;\n    letter-spacing: -0.025em;\n    margin: 0 0 22px;\n    color: var(--ink);\n    max-width: 880px;\n  }\n  .home-stats {\n    display: flex; flex-wrap: wrap; gap: 14px 28px;\n    font-family: var(--serif);\n    font-size: 16px;\n    color: var(--ink-3);\n  }\n  .home-stats span b {\n    color: var(--ink);\n    font-size: 20px;\n    font-weight: 600;\n    margin-right: 4px;\n  }\n  .section-label {\n    font-size: 12px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--ink-3);\n    font-weight: 600;\n    margin-bottom: 14px;\n  }\n  .home-lead { margin-bottom: 36px; }\n  .lead-card {\n    display: block;\n    text-decoration: none;\n    padding: 30px 32px;\n    border: 1px solid var(--rule);\n    border-radius: 14px;\n    background: var(--surface, #fff);\n    transition: border-color .12s;\n  }\n  .lead-card:hover { border-color: var(--accent-bd); }\n  .lead-kicker {\n    display: flex; align-items: center; gap: 10px;\n    flex-wrap: wrap;\n    margin-bottom: 12px;\n  }\n  .lead-meta {\n    font-size: 12.5px;\n    color: var(--ink-3);\n    letter-spacing: .04em;\n    text-transform: uppercase;\n  }\n  .lead-title {\n    font-family: var(--serif);\n    font-size: 36px;\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n    color: var(--ink);\n    margin: 0 0 14px;\n  }\n  .lead-thesis {\n    font-family: var(--serif);\n    font-size: 19px;\n    line-height: 1.55;\n    color: var(--ink-2);\n    font-style: italic;\n    max-width: 760px;\n    margin: 0;\n  }\n  .lead-thesis-quiet { font-style: normal; color: var(--ink-3); }\n  .home-secondaries { margin-bottom: 40px; }\n  .secondary-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n  .secondary-card {\n    display: block;\n    text-decoration: none;\n    padding: 22px 24px;\n    border: 1px solid var(--rule);\n    border-radius: 11px;\n    background: var(--surface, #fff);\n    transition: border-color .12s;\n  }\n  .secondary-card:hover { border-color: var(--accent-bd); }\n  .secondary-kicker {\n    display: flex; align-items: center; gap: 8px;\n    flex-wrap: wrap;\n    margin-bottom: 10px;\n  }\n  .secondary-meta {\n    font-size: 11.5px;\n    color: var(--ink-3);\n    letter-spacing: .04em;\n    text-transform: uppercase;\n  }\n  .secondary-title {\n    font-family: var(--serif);\n    font-size: 22px;\n    line-height: 1.22;\n    color: var(--ink);\n    margin: 0 0 10px;\n  }\n  .secondary-thesis {\n    font-family: var(--serif);\n    font-size: 14.5px;\n    line-height: 1.55;\n    color: var(--ink-2);\n    margin: 0;\n  }\n  .secondary-thesis-quiet { color: var(--ink-3); }\n  .home-tail { margin-bottom: 40px; }\n  .intent-badge {\n    display: inline-block;\n    font-size: 10px;\n    padding: 2px 9px;\n    border-radius: 4px;\n    font-weight: 600;\n    letter-spacing: .04em;\n  }\n  .intent-investigation { background: rgba(77,156,111,.16); color: #4d9c6f; }\n  .intent-argument { background: rgba(201,106,83,.16); color: #c96a53; }\n  .intent-pattern { background: rgba(126,166,216,.16); color: #7ea6d8; }\n  .intent-hypothesis { background: rgba(183,158,224,.16); color: #b79ee0; }\n  .intent-assessment { background: rgba(209,171,92,.16); color: #d1ab5c; }\n  .intent-critique { background: rgba(196,123,152,.16); color: #c47b98; }\n  .intent-explanation { background: rgba(126,200,227,.16); color: #7ec8e3; }\n\n  /* Operator overlays — visible only when the session cookie is set.\n     Woven into the same page everyone reads; no parallel dashboard. */\n  .op-briefing {\n    margin: 0 0 28px;\n    padding: 18px 22px;\n    border: 1px solid var(--accent-bd, var(--rule));\n    background: var(--accent-bg, rgba(58, 99, 160, 0.06));\n    border-radius: 8px;\n  }\n  .op-briefing-kicker {\n    font-size: 11px; letter-spacing: .12em;\n    text-transform: uppercase;\n    color: var(--ink-3); font-weight: 600;\n    margin-bottom: 6px;\n  }\n  .op-briefing p {\n    margin: 0;\n    font-family: var(--serif);\n    font-size: 16.5px; line-height: 1.55;\n    color: var(--ink-2);\n  }\n  .op-briefing p b { color: var(--ink); font-weight: 600; }\n\n  .op-today {\n    margin: -14px 0 28px;\n    padding: 10px 22px;\n    border: 1px solid var(--rule);\n    background: var(--paper-2, var(--surface));\n    border-radius: 8px;\n  }\n  .op-today p { margin: 0; font-family: var(--mono); font-size: 12px; color: var(--ink-3); }\n  .op-today-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }\n  .op-bulk-expand-go {\n    flex-shrink: 0;\n    padding: 7px 14px; font-family: var(--mono); font-size: 11.5px;\n    background: transparent; color: var(--accent);\n    border: 1px solid var(--accent-bd, var(--rule)); border-radius: 5px; cursor: pointer;\n  }\n  .op-bulk-expand-go:hover { background: var(--accent); color: var(--paper); }\n\n  .op-drafts { margin-bottom: 36px; }\n  .op-draft {\n    display: block;\n    text-decoration: none;\n    padding: 22px 24px;\n    margin-bottom: 12px;\n    border: 1px solid var(--rule);\n    border-radius: 10px;\n    background: var(--paper-2, var(--surface));\n    transition: border-color .12s;\n  }\n  .op-draft:hover { border-color: var(--accent); }\n  .op-draft-kicker {\n    display: flex; gap: 10px; flex-wrap: wrap;\n    align-items: center;\n    margin-bottom: 10px;\n  }\n  .op-draft-meta {\n    font-size: 11.5px;\n    color: var(--ink-3);\n    letter-spacing: .03em;\n    text-transform: uppercase;\n  }\n  .op-draft-title {\n    font-family: var(--serif);\n    font-size: 22px;\n    line-height: 1.2;\n    color: var(--ink);\n    margin-bottom: 8px;\n  }\n  .op-draft-thesis {\n    font-family: var(--serif);\n    font-size: 15.5px;\n    line-height: 1.55;\n    font-style: italic;\n    color: var(--ink-2);\n    margin: 0 0 10px;\n  }\n  .op-draft-cta {\n    font-size: 13px;\n    color: var(--accent);\n    font-weight: 600;\n  }\n\n  .op-findings { margin-top: 12px; margin-bottom: 36px; padding-top: 28px; border-top: 1px solid var(--rule); }\n  .op-findings-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n  .op-finding {\n    padding: 16px 18px;\n    border: 1px solid var(--rule);\n    border-radius: 9px;\n    background: var(--surface, #fff);\n  }\n  .op-finding-kicker {\n    font-size: 10.5px; letter-spacing: .11em;\n    text-transform: uppercase;\n    color: var(--ink-3); font-weight: 600;\n    margin-bottom: 6px;\n  }\n  .op-finding-title {\n    font-family: var(--serif);\n    font-size: 16px; line-height: 1.3;\n    color: var(--ink);\n    margin-bottom: 6px;\n  }\n  .op-finding-body {\n    margin: 0 0 10px;\n    font-size: 13.5px; line-height: 1.55;\n    color: var(--ink-2);\n  }\n  a.op-finding-linked {\n    display: block; text-decoration: none; color: inherit;\n    transition: border-color .15s;\n  }\n  a.op-finding-linked:hover { border-color: var(--ink-3); }\n  .op-finding-cta, .op-thread-cta {\n    font-family: var(--mono); font-size: 11px; color: var(--accent);\n  }\n  .op-finding-research, .op-thread-research { margin-top: 4px; }\n  .op-finding-research-go, .op-thread-research-go {\n    padding: 6px 12px; font-family: var(--mono); font-size: 11px;\n    background: transparent; color: var(--accent);\n    border: 1px solid var(--accent-bd, var(--rule)); border-radius: 5px; cursor: pointer;\n  }\n  .op-finding-research-go:hover, .op-thread-research-go:hover {\n    background: var(--accent); color: var(--paper);\n  }\n\n  .op-threads { margin-bottom: 36px; }\n  .op-threads-list { display: flex; flex-direction: column; }\n  .op-thread {\n    display: flex; gap: 14px; align-items: center; flex-wrap: wrap;\n    padding: 10px 0;\n    border-top: 1px solid var(--rule);\n  }\n  a.op-thread-linked {\n    display: flex; gap: 14px; align-items: baseline;\n    text-decoration: none; color: inherit;\n    padding: 10px 0;\n    border-top: 1px solid var(--rule);\n  }\n  .op-thread:first-child, a.op-thread-linked:first-child { border-top: none; }\n  .op-thread-status {\n    flex-shrink: 0;\n    font-size: 10.5px; letter-spacing: .08em;\n    text-transform: uppercase;\n    color: var(--ink-3); font-weight: 600;\n    min-width: 80px;\n  }\n  .op-thread-status.pursuing { color: var(--accent); }\n  .op-thread-q {\n    font-family: var(--serif);\n    font-size: 15px; line-height: 1.5;\n    color: var(--ink-2);\n    flex: 1;\n  }\n\n  @media (max-width: 720px) {\n    .home-hero { font-size: 36px; }\n    .lead-title { font-size: 28px; }\n    .lead-thesis { font-size: 17px; }\n    .secondary-grid { grid-template-columns: 1fr; }\n    .op-findings-grid { grid-template-columns: 1fr; }\n  }\n</style>\n</div>\n</main>\n<aside class=\"trust\" aria-label=\"How this site verifies\">\n  <div class=\"trust-inner\">\n    <span class=\"trust-mark\" aria-hidden=\"true\">✓</span>\n    <p>\n      Every documented fact on this site is backed by a word-for-word quote\n      from a source document we have stored — checked by machine, not vouched\n      for. Disputed claims are shown as disputed. Claims that fail\n      verification are removed, and we say so.\n      <a href=\"/method\">How verification works →</a>\n    </p>\n  </div>\n</aside>\n<footer class=\"foot\">\n  <div class=\"foot-inner\">\n    <div>\n      <a href=\"/\" class=\"wordmark\">CANOPTICON<span class=\"dot\">·</span></a>\n      <div class=\"coord\" style=\"margin-top:8px\">THE STANDING RECORD <span class=\"sep\">·</span> canopticon.com <span class=\"sep\">·</span> @canoptics</div>\n    </div>\n    <div class=\"foot-links\">\n      <a href=\"/\">The Record</a>\n      <a href=\"/investigations\">Investigations</a>\n      <a href=\"/watchlist\">Watchlist</a>\n      <a href=\"/library\">Library</a>\n      <a href=\"/activity\">Activity</a>\n      <a href=\"/method\">Method</a>\n 