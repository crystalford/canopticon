  "body": "<!doctype html>\n<html lang=\"en\" data-mode=\"public\" data-zone=\"topics\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n<title>Profile · Marshall McLuhan — CANOPTICON</title>\n<meta name=\"description\" content=\"Profile of Marshall McLuhan, drawn from extracted source documents.\" />\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&display=swap\" />\n<link rel=\"stylesheet\" href=\"/styles.css?v=bos3ko\" />\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n<link rel=\"alternate icon\" href=\"/favicon.ico\" />\n</head>\n<body>\n<nav class=\"nav\">\n  <div class=\"nav-inner\">\n    <a href=\"/\" class=\"wordmark\">CANOPTICON<span class=\"dot\">·</span><span class=\"wordmark-sub\">The standing record</span></a>\n    <input type=\"checkbox\" id=\"nav-toggle\" class=\"nav-toggle\" />\n    <label for=\"nav-toggle\" class=\"nav-burger\" aria-label=\"Menu\"><span></span></label>\n    <div class=\"nav-links\">\n      <a href=\"/\">Record</a>\n      <a href=\"/investigations\">Investigations</a>\n      <a href=\"/watchlist\">Watchlist</a>\n      <a href=\"/method\">Method</a>\n      <a href=\"/search\" class=\"nav-search\"><span class=\"q\">/</span> ask the record</a>\n    </div>\n  </div>\n</nav>\n<main class=\"record-main\">\n<div class=\"container\">\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"name\":\"Marshall McLuhan\",\"description\":\"Profile of Marshall McLuhan, drawn from extracted source documents.\",\"url\":\"https://canopticon.com/profile/marshall-mcluhan\",\"publisher\":{\"@id\":\"https://canopticon.com/#org\"}}</script>\n<article class=\"arr-page\">\n  <header class=\"arr-head\">\n    <div class=\"kicker\">Profile</div>\n    <h1 class=\"arr-h1\">Marshall McLuhan</h1>\n    <p class=\"arr-sub\">\n      Profile for Marshall McLuhan.\n      Every fact below is a verbatim quote from a real document we have stored.\n      <a class=\"arr-back\" href=\"/s/marshall-mcluhan\">↩ See the full Record</a>\n    </p>\n  </header>\n\n  <div class=\"profile-block\">\n  \n  \n  <section class=\"profile-rels\" data-schema=\"ItemList\">\n  <div class=\"sec-k\">Relationships</div>\n  <div class=\"profile-rels-list\">\n    <div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\"><a href=\"/s/mark-logan\">Mark Logan</a></span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Language</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Biofeedback</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">The Gutenberg Galaxy</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Understanding Media</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Neuroscience</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Carr</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Hayles</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\"><a href=\"/s/wolf\">Wolf</a></span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Dehaene</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Barkley</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">The Mechanical Bride</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Understanding Media</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Laws of Media</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Understanding Media</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">The Medium is the Massage</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Narcissus</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Publication of The Medium is the Massage</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">publication of From Cliché to Archetype</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\"><a href=\"/s/james-joyce\">James Joyce</a></span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">T.S. Eliot</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">W.B. Yeats</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Ezra Pound</span>\n  \n</div><div class=\"profile-rel\">\n  <span class=\"profile-rel-type\">other</span>\n  <span class=\"profile-rel-target\">Eugène Ionesco</span>\n  \n</div>\n  </div>\n</section>\n  <section class=\"profile-facts\" data-schema=\"ItemList\">\n  <div class=\"sec-k\">Established facts</div>\n  <ul class=\"profile-facts-list\">\n    <li>McLuhan was an environmental thinker in the literal sense — his entire project is about media as environments. <a class=\"profile-receipt\" href=\"/q/68274aad-8c0d-40eb-aa23-7dba008fb976\">↗</a> <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li><li>McLuhan has very little to say about ecological environmentalism per se. <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li><li>McLuhan would approve. <a class=\"profile-receipt\" href=\"/q/4cc4c177-027e-42a9-b527-e906bbfe2089\">↗</a> <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li><li>The &#39;we shape our tools&#39; line is from Culkin 1967 <a class=\"profile-receipt\" href=\"/q/e0d12ff3-88ca-491c-839e-3192e549e737\">↗</a> <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li><li>The McLuhan-citation industry captures the brand and loses the substance <a class=\"profile-receipt\" href=\"/q/e9660390-c15f-45c1-ac14-da754cbf313d\">↗</a> <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li><li>the tetrad&#39;s fourth law is when a medium is pushed to its limits, it reverses into its opposite <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li><li>the global village is not a peaceful unity <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li><li>McLuhan&#39;s work was published in 1968 <a class=\"profile-receipt\" href=\"/q/da48952f-efca-4e84-9b1f-b01e15767f98\">↗</a> <span class=\"profile-fact-src\">· <a href=\"/library/compass-artifact-wf-c62ae192-bf63-4c64-a93b-867d0dd1cddd-text-markdown\">source</a></span></li>\n  </ul>\n</section>\n  <div class=\"profile-prov\">Drawn from 9 source documents in the Library. Every attribute and relationship above traces back to a verbatim quote.</div>\n</div>\n<style>\n  .profile-block { margin: 0; }\n  .profile-block .sec-k {\n    font-size: 11px; letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--ink-3); font-weight: 600;\n    margin: 28px 0 14px;\n  }\n  .profile-block section:first-of-type .sec-k { margin-top: 0; }\n  .profile-narrative-body {\n    font-family: var(--serif);\n    font-size: 16.5px; line-height: 1.65;\n    color: var(--ink);\n    max-width: 720px;\n  }\n  .profile-narrative-body h2 {\n    font-family: var(--serif);\n    font-size: 15px; font-weight: 600;\n    letter-spacing: .02em;\n    color: var(--ink);\n    margin: 26px 0 10px;\n  }\n  .profile-narrative-body h2:first-child { margin-top: 0; }\n  .profile-narrative-body p { margin: 0 0 14px; }\n  .profile-narrative-body .cite-n { color: var(--accent); text-decoration: none; font-size: 11px; }\n  .profile-narrative-body .cite-n:hover { text-decoration: underline; }\n  .profile-dl {\n    display: grid;\n    grid-template-columns: 180px 1fr;\n    gap: 10px 24px;\n    margin: 0;\n  }\n  .profile-dl dt {\n    font-family: var(--mono);\n    font-size: 12.5px;\n    color: var(--ink-3);\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    padding-top: 3px;\n  }\n  .profile-dl dd {\n    font-family: var(--serif);\n    font-size: 16px; line-height: 1.5;\n    color: var(--ink);\n    margin: 0;\n  }\n  .profile-receipt { color: var(--accent); text-decoration: none; font-size: 11px; }\n  .profile-receipt:hover { text-decoration: underline; }\n  .profile-rels-list { display: flex; flex-direction: column; }\n  .profile-rel {\n    display: flex; align-items: baseline; gap: 14px;\n    padding: 10px 0;\n    border-top: 1px solid var(--rule);\n  }\n  .profile-rel:first-child { border-top: none; }\n  .profile-rel-type {\n    font-family: var(--mono);\n    font-size: 12px;\n    color: var(--ink-3);\n    text-transform: uppercase;\n    letter-spacing: .03em;\n    min-width: 110px;\n  }\n  .profile-rel-target {\n    font-family: var(--serif);\n    font-size: 15.5px;\n    color: var(--ink);\n    flex: 1;\n  }\n  .profile-rel-target a { color: var(--accent); text-decoration: none; }\n  .profile-rel-target a:hover { text-decoration: underline; }\n  .profile-rel-when {\n    font-family: var(--mono);\n    font-size: 11.5px;\n    color: var(--ink-3);\n  }\n  .profile-facts-list { list-style: none; padding: 0; margin: 0; }\n  .profile-facts-list li {\n    font-family: var(--serif);\n    font-size: 15.5px; line-height: 1.5;\n    color: var(--ink-2);\n    padding: 10px 0;\n    border-top: 1px solid var(--rule);\n  }\n  .profile-facts-list li:first-child { border-top: none; }\n  .profile-fact-src { color: var(--ink-3); font-size: 13px; }\n  .profile-fact-src a { color: var(--accent); text-decoration: none; }\n  .profile-prov {\n    margin-top: 24px;\n    padding: 12px 16px;\n    background: var(--paper-2, #f4f1ea);\n    border: 1px solid var(--rule);\n    border-radius: 7px;\n    font-size: 13px;\n    color: var(--ink-3);\n  }\n</style>\n</article>\n\n<style>\n  .arr-page { max-width: 880px; margin: 0 auto; padding: 28px 0 80px; }\n  .arr-head { margin-bottom: 36px; max-width: 760px; }\n  .arr-head .kicker