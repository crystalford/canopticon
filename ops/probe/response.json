hed in 1988\",\"subjectOf\":[{\"@type\":\"Event\",\"name\":\"publication of Laws of Media\",\"startDate\":\"1988\"}]}</script>\n<article class=\"subject-page\">\n  \n  \n  \n  \n  <header class=\"subject-head\">\n    <div class=\"stamp\">\n  <div class=\"stamp-top\"><span class=\"fileno\">FILE ON LAWS OF MEDIA</span><span class=\"kindchip\">Entity</span></div>\n  <div class=\"stamp-body\">\n    <h1>Laws of Media</h1>\n    <p class=\"desig\">the tetrad is a structured, four-part heuristic<a class=\"qref\" href=\"/q/5e6ecbe5-7014-4cc7-ba2e-2fc16fb1566d\" title=\"he meant it as a structured, four-part heuristic that any analyst could apply to any artifact\"><sup>1</sup></a>. Laws of Media was published in 1988<a class=\"qref\" href=\"/q/d663fdaa-fdee-476e-86a7-25386e46cb3e\" title=\"*Laws of Media* (1988)\"><sup>2</sup></a>.</p>\n  </div>\n  <div class=\"stamp-foot\"><div class=\"coord\"><a class=\"jump\" href=\"#on-file\">3 SOURCES</a> <span class=\"sep\">·</span> <a class=\"jump\" href=\"#on-the-record\">2 DOCUMENTED FACTS</a> <span class=\"sep\">·</span> <a class=\"jump\" href=\"#disputed\">1 DISPUTED</a> <span class=\"sep\">·</span> OPENED 2026-07-24 <span class=\"sep\">·</span> UPDATED <span class=\"hi\">2026-07-24</span></div></div>\n</div>\n    <div class=\"thin-note thin-card\">\n  <div class=\"thin-top\">\n    <span class=\"thin-badge\"><span class=\"thin-badge-b\"></span>DEVELOPING FILE</span>\n    \n  </div>\n  <p class=\"thin-body\">This file has 3 sources on record so far <span class=\"redact-bar\" style=\"width:60px\"></span> more may surface as the record grows.</p>\n</div>\n  </header>\n\n  <div class=\"subject-grid\">\n    <div class=\"subject-main\">\n      \n      \n      <section id=\"on-the-record\" data-schema=\"ItemList\"><div class=\"sec-k\">On the record <a class=\"sec-standalone\" href=\"/profile/laws-of-media\">see profile →</a></div><div class=\"fact\" id=\"fact-12260dba-4584-4343-89b0-e71c0f0523db\">\n  <div class=\"fact-line\"><p class=\"fact-text\">the tetrad is a structured, four-part heuristic</p></div>\n  <details class=\"rcpt\">\n  <summary><span class=\"rdoc\"># A Comprehensive Map of Marshall McLuhan&#39;s Thought: Concept</span></summary>\n  <div class=\"rcpt-body\">\n    <div class=\"rcpt-q\">“he meant it as a structured, four-part heuristic that any analyst could apply to any artifact”</div>\n    <div class=\"rcpt-src\"><span>SOURCE</span><a href=\"/library/compass-artifact-wf-8d640283-1141-461e-8468-f03a148be915-text-markdown\"># A Comprehensive Map of Marshall McLuhan&#39;s Thought: Concept</a><span class=\"sep\">·</span><span>stored copy on file</span></div>\n    <div class=\"rcpt-v\">VERIFIED — a word-for-word match in the stored source</div>\n  </div>\n</details>\n</div><div class=\"fact\" id=\"fact-75fb931e-2de8-4b6f-90f0-7609ba478030\">\n  <div class=\"fact-line\"><p class=\"fact-text\">Laws of Media was published in 1988</p></div>\n  <details class=\"rcpt\">\n  <summary><span class=\"rdoc\"># A Comprehensive Map of Marshall McLuhan&#39;s Thought: Concept</span></summary>\n  <div class=\"rcpt-body\">\n    <div class=\"rcpt-q\">“*Laws of Media* (1988)”</div>\n    <div class=\"rcpt-src\"><span>SOURCE</span><a href=\"/library/compass-artifact-wf-8d640283-1141-461e-8468-f03a148be915-text-markdown\"># A Comprehensive Map of Marshall McLuhan&#39;s Thought: Concept</a><span class=\"sep\">·</span><span>stored copy on file</span></div>\n    <div class=\"rcpt-v\">VERIFIED — a word-for-word match in the stored source</div>\n  </div>\n</details>\n</div></section>\n      <section id=\"disputed\" data-schema=\"Claim\">\n<div class=\"sec-k\">Disputed — who says what, against what <a class=\"sec-standalone\" href=\"/ct/laws-of-media\">see standalone →</a></div>\n<p class=\"disputed-explainer\">These are things people say about Laws of Media that aren't settled fact — each one attributed to who's actually claiming it, so a claim never quietly passes as established just because it showed up in a document. Weigh it yourself.</p>\n<div class=\"contested-card\">\n  <div class=\"contested-stamp\">Disputed</div>\n  <blockquote class=\"contested-quote\">\"new technologies retrieve obsolesced older forms\"</blockquote>\n  <div class=\"contested-attribution\">\n    Asserted by <b>Marshall McLuhan</b> · stance: pro\n  </div>\n  <div class=\"contested-balance\">The evidence on file mostly supports this, but it's still someone's claim, not a settled fact.</div>\n  <a class=\"contested-src\" href=\"/library/compass-artifact-wf-8d640283-1141-461e-8468-f03a148be915-text-markdown\"># A Comprehensive Map of Marshall McLuhan&#39;s Thought: Concept ↗</a>\n</div>\n</section>\n      \n      <section id=\"timeline\" data-schema=\"Event\">\n  <div class=\"sec-k\">Timeline <a class=\"sec-standalone\" href=\"/t/laws-of-media\">see standalone →</a></div>\n  <section data-schema=\"ItemList\" data-schema-item=\"Event\">\n  <div class=\"tl-rail\"><div class=\"tl-year\">1988</div><div class=\"tl-item\">\n  <div class=\"tl-when\">1988</div>\n  <div class=\"tl-body\">\n    <div class=\"tl-label\">publication of Laws of Media</div>\n    <div class=\"tl-meta\"><a class=\"tl-receipt\" href=\"/q/da833026-df39-4fea-9649-b29578df5ea8\">receipt ↗</a> · <a class=\"tl-src\" href=\"/library/compass-artifact-wf-50866223-8fbb-4819-be3d-d3beea645f55-text-markdown\">source ↗</a></div>\n  </div>\n</div></div>\n  \n</section>\n<style>\n  .tl-year {\n    font-family: var(--mono);\n    font-size: 11px; letter-spacing: .1em;\n    text-transform: uppercase;\n    color: var(--ink-3);\n    padding: 14px 0 0;\n    margin-left: -14px;\n  }\n  .tl-rail > .tl-year:first-child { padding-top: 8px; }\n  .tl-more { margin-top: 6px; }\n  .tl-more summary {\n    cursor: pointer; font-family: var(--mono); font-size: 12px;\n    color: var(--accent); padding: 8px 0; list-style: none;\n  }\n  .tl-more summary::-webkit-details-marker { display: none; }\n  .tl-more summary::before { content: '+ '; }\n  .tl-more[open] summary::bef