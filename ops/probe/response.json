  "body": "<!doctype html>\n<html lang=\"en\" data-mode=\"public\" data-zone=\"home\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n<title>CANOPTICON — The standing record</title>\n<meta name=\"description\" content=\"Canopticon keeps files on power — documented facts with their receipts, disputes shown as disputes, and signed analysis.\" />\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&display=swap\" />\n<link rel=\"stylesheet\" href=\"/styles.css?v=4u1lyx\" />\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n<link rel=\"alternate icon\" href=\"/favicon.ico\" />\n</head>\n<body>\n<nav class=\"nav\">\n  <div class=\"nav-inner\">\n    <a href=\"/\" class=\"wordmark\">CANOPTICON<span class=\"dot\">·</span><span class=\"wordmark-sub\">The standing record</span></a>\n    <div class=\"nav-links\">\n      <a href=\"/\" class=\"active\">Record</a>\n      <a href=\"/investigations\">Investigations</a>\n      <a href=\"/method\">Method</a>\n      <a href=\"/search\" class=\"nav-search\"><span class=\"q\">/</span> ask the record</a>\n    </div>\n  </div>\n</nav>\n<main class=\"record-main\">\n<div class=\"container\">\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebSite\",\"@id\":\"https://canopticon.com/#site\",\"url\":\"https://canopticon.com/\",\"name\":\"CANOPTICON\",\"description\":\"A forensic intelligence publication system. Sourced claims, signed analysis, a typed graph of verified facts. Every assertion ties back to a verbatim quote from a stored source document.\",\"publisher\":{\"@id\":\"https://canopticon.com/#org\"}},{\"@type\":\"Organization\",\"@id\":\"https://canopticon.com/#org\",\"name\":\"CANOPTICON\",\"url\":\"https://canopticon.com/\",\"sameAs\":[\"https://twitter.com/canoptics\"]}]}</script>\n<section class=\"home-masthead\">\n  <div class=\"kicker\"><span class=\"live\"></span> A forensic record of power — facts on file, analysis signed</div>\n  <h1 class=\"home-hero\">Canopticon keeps files on power.</h1>\n  <div class=\"home-stats\">\n  <span><b>145</b> subjects on file</span>\n  <span><b>50</b> source documents stored</span>\n  \n  <span><b>8</b> disputed claims</span>\n  <span><b>2</b> claims removed — failed verification</span>\n</div>\n</section>\n\n\n\n\n<section class=\"home-lead\">\n  <div class=\"section-label\">The lead</div>\n  <a class=\"lead-card\" href=\"/s/canadian-polling-industry\">\n  <div class=\"lead-kicker\">\n    <span class=\"intent-badge intent-assessment\">Assessment</span>\n    <span class=\"lead-meta\">Subject</span>\n  </div>\n  <h2 class=\"lead-title\">Canadian polling industry</h2>\n  <p class=\"lead-thesis\">The Canadian polling industry operates with relatively weak oversight and a dominant market player.</p>\n</a>\n</section>\n\n<section class=\"home-secondaries\">\n  <div class=\"section-label\">Also developing</div>\n  <div class=\"secondary-grid\"><a class=\"secondary-card\" href=\"/s/pbo\">\n  <div class=\"secondary-kicker\"><span class=\"secondary-meta\">Subject</span></div>\n  <h3 class=\"secondary-title\">PBO</h3>\n  <p class=\"secondary-thesis secondary-thesis-quiet\">6 sources</p>\n</a><a class=\"secondary-card\" href=\"/s/polls\">\n  <div class=\"secondary-kicker\"><span class=\"secondary-meta\">Subject</span></div>\n  <h3 class=\"secondary-title\">polls</h3>\n  <p class=\"secondary-thesis secondary-thesis-quiet\">1 source</p>\n</a></div>\n</section>\n\n<section class=\"home-tail\">\n  <div class=\"section-label\">Across the fabric</div>\n  <div class=\"cards-3\"><a class=\"cardlink\" href=\"/s/model\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">model</div>\n  <div class=\"card-dek\">1 source</div>\n</a><a class=\"cardlink\" href=\"/s/stelco\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Stelco</div>\n  <div class=\"card-dek\">1 source</div>\n</a><a class=\"cardlink\" href=\"/s/mark-carney\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Mark Carney</div>\n  <div class=\"card-dek\">27 sources</div>\n</a><a class=\"cardlink\" href=\"/s/bank-of-canada\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Bank of Canada</div>\n  <div class=\"card-dek\">17 sources</div>\n</a><a class=\"cardlink\" href=\"/s/pierre-poilievre\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Pierre Poilievre</div>\n  <div class=\"card-dek\">6 sources</div>\n</a><a class=\"cardlink\" href=\"/s/cleveland-cliffs\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Cleveland-Cliffs</div>\n  <div class=\"card-dek\">1 source</div>\n</a><a class=\"cardlink\" href=\"/s/canada-strong-fund\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Canada Strong Fund</div>\n  <div class=\"card-dek\">10 sources</div>\n</a><a class=\"cardlink\" href=\"/s/rio-tinto-fer-et-titane\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Rio Tinto Fer et Titane</div>\n  <div class=\"card-dek\">1 source</div>\n</a><a class=\"cardlink\" href=\"/s/bank-for-international-settlements-bis\">\n  <div class=\"card-type\"><span style=\"margin-left:6px\">Subject</span></div>\n  <div class=\"card-title\">Bank for International Settlements (BIS)</div>\n  <div class=\"card-dek\">2 sources</div>\n</a></div>\n</section>\n\n\n\n\n<style>\n  .home-masthead { margin-bottom: 40px; }\n  .home-masthead .kicker { margin-bottom: 18px; }\n  .home-hero {\n    font-family: var(--serif);\n    font-size: 48px; line-height: 1.08;\n    letter-spacing: -0.025em;\n    margin: 0 0 22px;\n    color: var(--ink);\n    max-width: 880px;\n  }\n  .home-stats {\n    display: flex; flex-wrap: wrap; gap: 14px 28px;\n    font-family: var(--serif);\n    font-size: 16px;\n    color: var(--ink-3);\n  }\n  .home-stats span b {\n    color: var(--ink);\n    font-size: 20px;\n    font-weight: 600;\n    margin-right: 4px;\n  }\n  .section-label {\n    font-size: 12px;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--ink-3);\n    font-weight: 600;\n    margin-bottom: 14px;\n  }\n  .home-lead { margin-bottom: 36px; }\n  .lead-card {\n    display: block;\n    text-decoration: none;\n    padding: 30px 32px;\n    border: 1px solid var(--rule);\n    border-radius: 14px;\n    background: var(--surface, #fff);\n    transition: border-color .12s;\n  }\n  .lead-card:hover { border-color: var(--accent-bd); }\n  .lead-kicker {\n    display: flex; align-items: center; gap: 10px;\n    flex-wrap: wrap;\n    margin-bottom: 12px;\n  }\n  .lead-meta {\n    font-size: 12.5px;\n    color: var(--ink-3);\n    letter-spacing: .04em;\n    text-transform: uppercase;\n  }\n  .lead-title {\n    font-family: var(--serif);\n    font-size: 36px;\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n    color: var(--ink);\n    margin: 0 0 14px;\n  }\n  .lead-thesis {\n    font-family: var(--serif);\n    font-size: 19px;\n    line-height: 1.55;\n    color: var(--ink-2);\n    font-style: italic;\n    max-width: 760px;\n    margin: 0;\n  }\n  .lead-thesis-quiet { font-style: normal; color: var(--ink-3); }\n  .home-secondaries { margin-bottom: 40px; }\n  .secondary-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n  .secondary-card {\n    display: block;\n    text-decoration: none;\n    padding: 22px 24px;\n    border: 1px solid var(--rule);\n    border-radius: 11px;\n    background: var(--surface, #fff);\n    transition: border-color .12s;\n  }\n  .secondary-card:hover { border-color: var(--accent-bd); }\n  .secondary-kicker {\n    display: flex; align-items: center; gap: 8px;\n    flex-wrap: wrap;\n    margin-bottom: 10px;\n  }\n  .secondary-meta {\n    font-size: 11.5px;\n    color: var(--ink-3);\n    letter-spacing: .04em;\n    text-transform: uppercase;\n  }\n  .secondary-title {\n    font-family: var(--serif);\n    font-size: 22px;\n    line-height: 1.22;\n    color: var(--ink);\n    margin: 0 0 10px;\n  }\n  .secondary-thesis {\n    font-family: var(--serif);\n    font-size: 14.5px;\n    line-height: 1.55;\n    color: var(--ink-2);\n    margin: 0;\n  }\n  .secondary-thesis-quiet { color: var(--ink-3); }\n  .home-tail { margin-bottom: 40px; }\n  .intent-badge {\n    display: inline-block;\n    font-size: 10px;\n    padding: 2px 9px;\n    border-radius: 4px;\n    font-weight: 600;\n    letter-spacing: .04em;\n  }\n  .intent-investigation { background: rgba(77,156,111,.16); color: #4d9c6f; }\n  .intent-argument { background: rgba(201,106,83,.16); color: #c96a53; }\n  .intent-pattern { background: rgba(126,166,216,.16); color: #7ea6d8; }\n  .intent-hypothesis { background: rgba(183,158,224,.16); color: #b79ee0; }\n  .intent-assessment { background: rgba(209,171,92,.16); color: #d1ab5c; }\n  .intent-critique { background: rgba(196,123,152,.16); color: #c47b98; }\n  .intent-explanation { background: rgba(126,200,227,.16); color: #7ec8e3; }\n\n  /* Operator overlays — visible only when the session cookie is set.\n     Woven into the same page everyone reads; no parallel dashboard. */\n  .op-briefing {\n    margin: 0 0 28px;\n    padding: 18px 22px;\n    border-left: 3px solid var(--accent);\n    background: var(--accent-bg, rgba(58, 99, 160, 0.06));\n    border-radius: 4px;\n  }\n  .op-briefing-kicker {\n    font-size: 11px; letter-spacing: .12em;\n    text-transform: uppercase;\n    color: var(--ink-3); font-weight: 600;\n    margin-bottom: 6px;\n  }\n  .op-briefing p {\n    margin: 0;\n    font-family: var(--serif);\n    font-size: 16.5px; line-height: 1.55;\n    color: var(--ink-2);\n  }\n  .op-briefing p b { color: var(--ink); font-weight: 600; }\n\n  .op-drafts { margin-bottom: 36px; }\n  .op-draft {\n    display: block;\n    text-decoration: none;\n    padding: 22px 24px;\n    margin-bottom: 12px;\n    border: 1px solid var(--rule);\n    border-left: 3px solid var(--accent);\n    border-radius: 10px;\n    background: var(--paper-2, var(--surface));\n    transition: border-color .12s;\n  }\n  .op-draft:hover { border-color: var(--accent); }\n  .op-draft-kicker {\n    display: flex; gap: 10px; flex-wrap: wrap;\n    align-items: center;\n    margin-bottom: 10px;\n  }\n  .op-draft-meta {\n    font-size: 11.5px;\n    color: var(--ink-3);\n    letter-spacing: .03em;\n    text-transform: uppercase;\n  }\n  .op-draft-title {\n    font-family: var(--serif);\n    font-size: 22px;\n    line-height: 1.2;\n    color: var(--ink);\n    margin-bottom: 8px;\n  }\n  .op-draft-thesis {\n    font-family: var(--serif);\n    font-size: 15.5px;\n    line-height: 1.55;\n    font-style: italic;\n    color: var(--ink-2);\n    margin: 0 0 10px;\n  }\n  .op-draft-cta {\n    font-size: 13px;\n    color: var(--accent);\n    font-weight: 600;\n  }\n\n  .op-findings { margin-top: 12px; margin-bottom: 36px; padding-top: 28px; border-top: 1px solid var(--rule); }\n  .op-findings-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n  .op-finding {\n    padding: 16px 18px;\n    border: 1px solid var(--rule);\n    border-radius: 9px;\n    background: var(--surface, #fff);\n  }\n  .op-finding-kicker {\n    font-size: 10.5px; letter-spacing: .11em;\n    text-transform: uppercase;\n    color: var(--ink-3); font-weight: 600;\n    margin-bottom: 6px;\n  }\n  .op-finding-title {\n    font-family: var(--serif);\n    font-size: 16px; line-height: 1.3;\n    color: var(--ink);\n    margin-bottom: 6px;\n  }\n  .op-finding-body {\n    margin: 0;\n    font-size: 13.5px; line-height: 1.55;\n    color: var(--ink-2);\n  }\n\n  .op-threads { margin-bottom: 36px; }\n  .op-threads-list { display: flex; flex-direction: column; }\n  .op-thread {\n    display: flex; gap: 14px; align-items: baseline;\n    padding: 10px 0;\n    border-top: 1px solid var(--rule);\n  }\n  .op-thread:first-child { border-top: none; }\n  .op-thread-status {\n    flex-shrink: 0;\n    font-size: 10.5px; letter-spacing: .08em;\n    text-transform: uppercase;\n    color: var(--ink-3); font-weight: 600;\n    min-width: 80px;\n  }\n  .op-thread-status.pursuing { color: var(--accent); }\n  .op-thread-q {\n    font-family: var(--serif);\n    font-size: 15px; line-height: 1.5;\n    color: var(--ink-2);\n  }\n\n  @media (max-width: 720px) {\n    .home-hero { font-size: 36px; }\n    .lead-title { font-size: 28px; }\n    .lead-thesis { font-size: 17px; }\n    .secondary-grid { grid-template-columns: 1fr; }\n    .op-findings-grid { grid-template-columns: 1fr; }\n  }\n</style>\n</div>\n</main>\n<aside class=\"trust\" aria-label=\"How this site verifies\">\n  <div class=\"trust-inner\">\n    <span class=\"trust-mark\" aria-hidden=\"true\">✓</span>\n    <p>\n      Every documented fact on this site is backed by a word-for-word quote\n      from a source document we have stored — checked by machine, not vouched\n      for. Disputed claims are shown as disputed. Claims that fail\n      verification are removed, and we say so.\n      <a href=\"/method\">How verification works →</a>\n    </p>\n  </div>\n</aside>\n<footer class=\"foot\">\n  <div class=\"foot-inner\">\n    <div>\n      <a href=\"/\" class=\"wordmark\">CANOPTICON<span class=\"dot\">·</span></a>\n      <div class=\"coord\" style=\"margin-top:8px\">THE STANDING RECORD <span class=\"sep\">·</span> canopticon.com <span class=\"sep\">·</span> @canoptics</div>\n    </div>\n    <div class=\"foot-links\">\n      <a href=\"/\">The Record</a>\n      <a href=\"/investigations\">Investigations</a>\n      <a href=\"/method\">Method</a>\n      <a href=\"/search\">Search</a>\n    </div>\n  </div>\n</footer>\n</body>\n</html>"
