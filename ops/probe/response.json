  "body": "{\n  \"ok\": true,\n  \"model\": \"@cf/meta/llama-4-scout-17b-16e-instruct\",\n  \"max_tokens\": 4000,\n  \"latency_ms\": 6191,\n  \"raw_type\": \"object\",\n  \"raw_keys\": [\n    \"response\",\n    \"tool_calls\",\n    \"usage\"\n  ],\n  \"raw\": {\n    \"response\": \"```json\\n{\\n  \\\"entities\\\": [\\n    {\\n      \\\"name\\\": \\\"Meridian Crest Developments\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Provincial Audit Office\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Dunmore Lands\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Provincial Housing Acceleration Fund\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"Standing Committee on Housing Policy\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"March\\\"\\n    },\\n    {\\n      \\\"name\\\": \\\"March 2025\\\"\\n    }\\n  ],\\n  \\\"facts\\\": [\\n    {\\n      \\\"text\\\": \\\"The provincial housing acceleration fund disbursed 48.2 million dollars to Meridian Crest Developments in March 2025.\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"The stated purpose of the acceleration stream was to speed construction starts on underused urban land near transit corridors.\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"The audit found that twelve months after disbursement, zero housing starts had occurred on the Dunmore Lands parcel central to the funding agreement.\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"The ministerial zoning order issued in the same period revalued the 410-acre parcel upward, increasing its assessed land value without any corresponding construction activity.\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"The committee transcript from the Standing Committee on Housing Policy shows the ministry disputing this characterization, arguing that pre-construction site preparation constituted meaningful progress toward the stated goal.\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"The Provincial Audit Office released a value-for-money review.\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"The Dunmore Lands parcel is 410 acres.\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"The disbursement occurred in March 2025.\\\"\\n    }\\n  ]\\n}\\n```\",\n    \"tool_calls\": [],\n    \"usage\": {\n      \"prompt_tokens\": 663,\n      \"completion_tokens\": 358,\n      \"total_tokens\": 1021,\n      \"prompt_tokens_details\": {\n        \"cached_tokens\": 0\n      },\n      \"neurons\": 43.937272729309996\n    }\n  }\n}"
