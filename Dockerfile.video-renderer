# Cloudflare Container image for the canopticon-video renderer.
#
# Lives at the REPO ROOT, not packages/video-renderer/. wrangler's
# Container build uses the directory containing this Dockerfile as the
# Docker build context (there is no separate --context flag) — and
# packages/video-renderer depends on the sibling workspace package
# @canopticon/shared (workspace:*), which only resolves if pnpm can see
# the whole monorepo. A build context scoped to packages/video-renderer/
# alone can never satisfy that dependency. Referenced from
# packages/video/wrangler.toml's [[containers]] image field as
# "../../Dockerfile.video-renderer".
#
# Phase 0 target: a 60-75s 1080×1920 Remotion render at standard-4
# (4 vCPU / 12 GiB / CPU-only) inside the 5-min wall-clock budget. The
# image installs the Node + Remotion + ffmpeg stack plus WhisperX +
# librosa (pre-installed even though Phase 0 doesn't call them — the
# image is the same one Phase 2 runs, no rebuild needed).

FROM node:22-slim AS base

# System deps. Chromium replaces a separate Chrome download — Remotion
# can use the system browser via CHROME_EXECUTABLE_PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    yt-dlp \
    python3 \
    python3-pip \
    fonts-inter \
    fonts-noto-color-emoji \
    chromium \
    chromium-driver \
    libnss3 \
    libatk-bridge2.0-0 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# WhisperX + librosa for Phase 2's word-level transcript alignment +
# beat-synced cutting. Phase 0 doesn't call these; installing now means
# the image doesn't need a rebuild when Phase 2 ships. The
# --break-system-packages flag is required on bookworm's Python; we're
# isolating in the Container anyway.
#
# torch/torchaudio are installed FIRST from PyTorch's CPU-only wheel
# index, before whisperx. Cloudflare Containers have no GPU (see
# CHROME_EXECUTABLE_PATH below — this is a CPU-only box throughout), but
# `pip install whisperx` pulls plain `torch` as a dependency, and PyPI's
# default linux torch wheel bundles the full CUDA runtime (nvidia-cublas,
# nvidia-cudnn, etc.) — several GB of libraries this Container can never
# use. Installing the CPU wheel first satisfies whisperx's version
# requirement, so its own install doesn't pull the CUDA build over it.
# This is what was blowing up the image: one apt/pip layer was large
# enough that pushing it to the Cloudflare registry outlasted the
# deploy's docker auth token, failing with "unauthorized" after 15+
# minutes stuck retrying a single blob (confirmed live, twice).
#
# pip MUST be upgraded before any of that runs. bookworm ships pip 23.0.1,
# which does not normalize underscores and hyphens in a wheel's metadata
# Name — so when it resolves `typing-extensions>=4.10.0` and the wheel
# declares `typing_extensions`, it rejects the wheel:
#
#   Requested typing-extensions>=4.10.0 ... has inconsistent Name:
#   expected 'typing-extensions', but metadata has 'typing_extensions'
#
# It then falls back to the source tarball, which needs the `flit_core`
# build backend — and because `--index-url` REPLACES PyPI rather than
# adding to it (that is deliberate, see above: it is what keeps the CUDA
# wheels out), flit_core cannot be found on the PyTorch index and the
# build dies:
#
#   ERROR: No matching distribution found for flit_core<4,>=3.11
#
# Nothing in this file changed to cause that — typing_extensions published
# a release whose metadata trips the old pip's bug, and the build started
# failing on its own. A current pip accepts the wheel, so the source-build
# path is never taken and no build backend is needed. Upgrading pip is the
# fix; switching to --extra-index-url would ALSO fix it but would reopen
# the multi-GB CUDA problem this layer exists to avoid.
RUN pip3 install --break-system-packages --no-cache-dir --upgrade pip \
  && pip3 install --break-system-packages --no-cache-dir \
    torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
  && pip3 install --break-system-packages --no-cache-dir \
    whisperx==3.* \
    librosa==0.10.*

WORKDIR /app

# Install pnpm via corepack so we use the same package manager as the
# rest of the monorepo.
RUN corepack enable

# The full workspace context pnpm needs to resolve
# @canopticon/shared: workspace:* — just the two packages actually
# involved (shared has no build step; its package.json exports point
# straight at .ts source), plus the manifests pnpm's workspace
# resolution and TypeScript's `extends` chain both need.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY packages/shared/src packages/shared/src
COPY packages/video-renderer/package.json packages/video-renderer/package.json
COPY packages/video-renderer/tsconfig.json packages/video-renderer/tsconfig.json
COPY packages/video-renderer/src packages/video-renderer/src

# A plain (unfiltered) install, not `pnpm install --filter
# "...@canopticon/video-renderer"`. The COPY set above already trims the
# workspace down to exactly the two packages this image needs, so an
# unfiltered install covers the same ground — but `--filter "...@X"`
# has a real quirk (confirmed by reproducing it locally): it does NOT
# create a node_modules folder inside packages the filter selector
# pulls in transitively (like @canopticon/shared here), so shared's own
# `zod` dependency never gets symlinked and tsc fails with "Cannot find
# module 'zod'" when compiling shared/src via the video-renderer build.
# A full install does not have this gap.
RUN pnpm install --prod=false --no-frozen-lockfile
RUN pnpm --filter @canopticon/video-renderer build

# Remotion expects a Chrome browser path. The Debian package is at
# /usr/bin/chromium; we tell Remotion explicitly and disable GPU because
# Cloudflare Containers don't expose one.
ENV CHROME_EXECUTABLE_PATH=/usr/bin/chromium
ENV REMOTION_CHROMIUM_DISABLE_GPU=true
ENV NODE_ENV=production

WORKDIR /app/packages/video-renderer
EXPOSE 8080
CMD ["node", "dist/server.js"]
