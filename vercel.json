{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "env": {
    "npm_config_legacy_peer_deps": "true"
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/webhook-renew",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/clips",
      "schedule": "*/30 * * * *"
    }
  ]
}