# Supabase (frontend + backend)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # exposed to browser; auth + reads via RLS
SUPABASE_SERVICE_ROLE_KEY=                   # backend only — never ship to frontend
SUPABASE_JWT_SECRET=                         # Worker uses this to verify user JWTs

# Anthropic (backend only)
ANTHROPIC_API_KEY=

# Cloudflare (deploy time)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend
API_BASE_URL=http://127.0.0.1:8787
R2_BUCKET_NAME=canopticon-sources
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# openparliament.ca (optional source feed — off by default)
OPENPARLIAMENT_USER_AGENT=canopticon-dev (contact@example.com)
OPERATOR_USER_ID=                            # only needed if Hansard cron is enabled

# Misc
NODE_ENV=development
LOG_LEVEL=info
