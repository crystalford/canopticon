# Canopticon v2 - Chat-first CMS
# Copy to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database"

# Auth
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
OPERATOR_EMAIL="your@email.com"
OPERATOR_PASSWORD="your-password"

# AI - Claude (main chat model)
ANTHROPIC_API_KEY=""

# AI - Perplexity (web research)
PERPLEXITY_API_KEY=""

# Video clip server (optional — enables YouTube clip extraction)
# See clip-server/README.md for setup (GCP free tier VM recommended)
CLIP_SERVER_URL=""
CLIP_SERVER_SECRET=""
