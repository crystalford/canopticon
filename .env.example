# CANOPTICON v2 — Environment Variables
# Copy to .env.local and fill in your values

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Neo4j AuraDB ───────────────────────────────────────────
NEO4J_URI=""
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""

# ─── Claude API ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Perplexity (web search / news agent) ───────────────────
PERPLEXITY_API_KEY=""

# ─── X / Twitter ────────────────────────────────────────────
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# ─── Cloudflare R2 (file storage) ───────────────────────────
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="canopticon"
R2_PUBLIC_URL=""

# ─── Image generation ───────────────────────────────────────
FAL_API_KEY=""

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="digest@canopticon.com"
DIGEST_TO_EMAIL=""

# ─── System ─────────────────────────────────────────────────
CRON_SECRET=""
